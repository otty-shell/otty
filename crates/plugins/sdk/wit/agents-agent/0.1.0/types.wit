package otty:agents-agent@0.1.0;

/// The values of the `agents` domain that its agent and provider
/// contracts share: whom a login is for, what an account may still use,
/// and why a part could not read. The provider contract
/// `otty:agents-provider` imports them from here.
interface types {
  use otty:host/types@0.1.0.{host-error, need};

  /// Why a part could not give what OTTY asked for.
  variant read-error {
    /// The part does not give this; an optional function's answer.
    not-supported,
    /// A host operation failed and the part gave up.
    host(host-error),
    /// What was read is not in a shape the part understands. The text
    /// names fields, never values.
    unexpected(string),
    /// The part can not read until the user does what `need` asks, such
    /// as give a key the part asks for or replace one the provider
    /// refused.
    needs-user(need),
    /// The provider refused the login the part read with, or the login
    /// expired: a login an agent keeps, such as a ChatGPT or a Claude
    /// login. The provider part does not know which agent keeps it, so
    /// OTTY asks the agent part that found it (`login-refused` of the
    /// agent contract) what the user must do.
    login-refused,
    /// Anything else, in plain words.
    failed(string),
  }

  /// What a login or an account is known by. Any of the fields may be
  /// missing; OTTY joins accounts by any of them.
  record identity {
    account-id: option<string>,
    organization-id: option<string>,
    email: option<string>,
  }

  /// What kind of login a key is.
  enum login-kind {
    /// A login to a subscription, such as a ChatGPT or Claude plan.
    subscription,
    /// An API key of an account.
    api-key,
    /// A token of a gateway that resells models.
    gateway-token,
  }

  /// One usage window, such as the five-hour or the weekly one.
  record limit-window {
    /// How long the window is, when the source tells.
    length-minutes: option<u32>,
    /// The model the window counts alone, such as "Opus"; none for a
    /// window of every model.
    model: option<string>,
    /// How much of the window is used, from 0 to 100; past 100 when
    /// used past its limit.
    percent-used: f64,
    /// When the window starts again, when known.
    resets-at-ms: option<s64>,
    /// When it starts again as the agent wrote it, for a source that
    /// gives no time.
    reset-text: option<string>,
  }

  /// The credits of an account paid for by a pool of credits.
  record credits {
    left: option<f64>,
    used: option<f64>,
    pool: option<f64>,
    renews-at-ms: option<s64>,
    is-unlimited: bool,
  }
}
