// The agent contract of the `agents` domain: what an agent part gives
// OTTY. A plugin exports it once for all its agent parts; OTTY names the
// part in each call (the `agent` argument, or `profile.agent`). The
// domain's shared values are in `types.wit` of this package.
package otty:agents-agent@0.1.0;

interface agent {
  use otty:host/types@0.1.0.{command, need};
  use otty:host/keys@0.1.0.{key-place};
  use otty:host/files@0.1.0.{file-info};
  use types.{read-error, identity, login-kind};

  /// A config folder of the agent on this computer.
  record profile-place {
    folder: string,
    /// Whether it is the agent's default folder, or the one its variable
    /// names, so the agent needs no variable to find it.
    is-default: bool,
  }

  /// One agent with one config folder, as OTTY asks about it.
  record profile {
    /// The id of the agent part being asked, such as `codex`.
    agent: string,
    folder: string,
    is-default: bool,
  }

  /// How an account of a logged-in profile is paid for.
  enum billing {
    usage-windows,
    credits,
    api-key,
  }

  /// A logged-in profile: whom it is logged in as, when its files tell.
  record connection {
    account: option<string>,
    plan: option<string>,
    billing: option<billing>,
  }

  /// Whether a profile can be used. OTTY itself tells when the agent's
  /// program is missing.
  variant profile-status {
    connected(connection),
    /// Nobody is logged in with the profile; the need says how to log in,
    /// such as a `run` of the agent's login command.
    not-logged-in(need),
    config-folder-not-found,
  }

  /// Whom a login or an answer is for: the provider's name as the agent
  /// wrote it, or the host a key is for when the agent names no provider.
  /// A name passes even when no installed plugin serves it, such as
  /// `google` or a local model: the host joins it to the provider part
  /// with that id when one is installed, and prices an answer by it.
  variant provider-ref {
    id(string),
    host(string),
  }

  /// A login, named by where its key sits.
  type login-ref = key-place;

  /// A login or a key found in a profile. Never the key itself.
  record login {
    kind: login-kind,
    for-whom: provider-ref,
    /// Where the host reads the key again.
    place: key-place,
    /// Whom the login is for, when the profile's files tell.
    identity: identity,
    plan: option<string>,
  }

  /// What one file tells about one conversation the agent can continue.
  /// The host joins what all the files of the session places tell about
  /// one id: the latest `changed-ms`, and the folder and the title of the
  /// latest record that names them. A session no record names a folder
  /// for is not listed; one with no title shows its id.
  record session {
    id: string,
    /// The project folder the session ran in.
    folder: option<string>,
    title: option<string>,
    changed-ms: s64,
  }

  /// What holds records: lines of files, or a SQLite database.
  enum place-kind {
    files,
    database,
  }

  /// Where some of the profile's records are, such as its sessions or its
  /// answers: the host walks the files of `glob`, keeps what each file
  /// gave and asks again only for the files that are new or changed.
  record place {
    glob: string,
    kind: place-kind,
  }

  /// One file or database of a place that the host asks to read, with
  /// its size and change time as the host listed it.
  record place-item {
    file: file-info,
    kind: place-kind,
  }

  /// Tokens of one answer. `input` leaves out what was read from the
  /// cache (`cached`); `cache-written` is the part of `input` written to
  /// the cache; `reasoning` is the part of `output` spent thinking.
  record token-count {
    input: u64,
    cached: u64,
    cache-written: u64,
    output: u64,
    reasoning: u64,
  }

  /// One answer of the model: a fact, as the agent wrote it. The host
  /// makes every total from these rows: the tokens of a day, of a
  /// project, of a session, their money and their accounts.
  record answer {
    /// What tells this answer from the others; the host counts answers
    /// with one identity once.
    identity: option<string>,
    /// The id of the session it was given in, as `read-sessions` names
    /// it, when the agent records it; the host sums the numbers of a
    /// session from the answers that name it.
    session: option<string>,
    at-ms: s64,
    /// The model as the provider names it.
    model: option<string>,
    /// Who served the answer, read from the agent's settings and files:
    /// the provider the agent wrote, else the host of its server. The
    /// host prices the tokens at this provider's price of the model,
    /// else at the maker's.
    provider: option<provider-ref>,
    /// The login that served it, when the agent records it.
    login: option<login-ref>,
    /// The project folder.
    project: option<string>,
    tokens: token-count,
    /// The cost the agent wrote, in millionths of a US dollar.
    cost-microdollars: option<u64>,
  }

  /// What a part saw in one file: the records of the kind it reads, the
  /// ones it understood, the agent's version written in the file, and
  /// the names (never values) of the fields it missed and found.
  record record-counts {
    seen: u64,
    understood: u64,
    version: option<string>,
    missing: list<string>,
    fields: list<string>,
  }

  /// What one read gives, and what it saw.
  record answers {
    answers: list<answer>,
    records: record-counts,
  }

  /// The agent's default config folder only: the one the agent uses with
  /// no variable set, or the one its variable names, marked `is-default`.
  /// OTTY ignores any other place; the user adds other folders as
  /// profiles.
  profiles: func(agent: string) -> list<profile-place>;
  /// Whether the profile is logged in.
  detect: func(profile: profile) -> profile-status;
  /// The agent's version written in the profile's newest files; none and
  /// OTTY runs `<program> --version` itself.
  version: func(profile: profile) -> option<string>;
  /// The logins and keys the profile holds. OTTY no longer asks: the
  /// provider part of the plugin finds the accounts in the profile.
  logins: func(profile: profile) -> list<login>;
  /// Where the profile's sessions are.
  session-places: func(profile: profile) -> list<place>;
  /// What one file or database of a session place tells about its
  /// sessions.
  read-sessions: func(profile: profile, item: place-item) -> result<list<session>, read-error>;
  /// Where the profile's answers are.
  spend-places: func(profile: profile) -> list<place>;
  /// Every answer in one file or database of a spend place.
  read-answers: func(profile: profile, item: place-item) -> result<answers, read-error>;
  /// The command that starts a new session, or continues `session`.
  launch: func(profile: profile, session: option<string>) -> command;
  /// What the user must do now that a provider refused `login` of the
  /// profile, or it expired. OTTY no longer asks: the provider part says
  /// it with a need of the account. It leaves with the other login
  /// functions.
  login-refused: func(profile: profile, login: login-ref) -> option<need>;
}

/// What a component with agent parts imports and exports.
world agent-part {
  import otty:host/types@0.1.0;
  import otty:host/keys@0.1.0;
  import otty:host/files@0.1.0;
  import otty:host/sqlite@0.1.0;
  import otty:host/http@0.1.0;
  import otty:host/programs@0.1.0;
  import otty:host/terminal@0.1.0;
  import otty:host/keyring@0.1.0;
  import otty:host/env@0.1.0;
  import otty:host/clock@0.1.0;
  import otty:host/log@0.1.0;
  import types;
  export agent;
}
