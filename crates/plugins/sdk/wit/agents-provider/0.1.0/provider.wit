// The provider contract of the `agents` domain: what a provider part
// gives OTTY. A plugin exports it once for all its provider parts; OTTY
// names the part in each call (the `provider` argument). A provider part
// owns its accounts (spec 2026-11-23-accounts-apart-from-profiles,
// Decisions 5 and 8): it finds them from the logins in the folders OTTY
// gives it, the profiles of the agent parts of its own plugin that its
// manifest names in `logins`, and OTTY's own logins of the part (Decision
// 6), and never sees another plugin's profiles. It reads an account's
// numbers any way it can, only in the account's folders: from the
// provider's server with the login there, or by asking the agent itself,
// such as `claude /usage` or the limits Codex writes in its files. It
// gets keys only as handles. The values it shares with the agent contract
// come from `otty:agents-agent/types`.
package otty:agents-provider@0.1.0;

interface provider {
  use otty:host/types@0.1.0.{command, need};
  use otty:host/keys@0.1.0.{given-key};
  use otty:agents-agent/types@0.1.0.{read-error};

  /// A folder where a login of this provider may sit. Inside it, for the
  /// call it is given to, the part reads what the `logins` of its
  /// manifest declare for its agent part.
  variant login-folder {
    /// A profile of an agent part of the same plugin: the agent part's
    /// id, such as `codex`, and the profile's config folder.
    profile(tuple<string, string>),
    /// OTTY's own login of this part: the own login's id and its folder,
    /// `<OTTY's data folder>/accounts/<id>`, where the agent of the
    /// `logins` entry that offers `log_in` logged in. The part reads there
    /// what that entry declares. It is never a profile: the part reads no
    /// session or project there for OTTY to show.
    own-login(tuple<string, string>),
  }

  /// What kind of account it is.
  enum account-kind {
    /// A subscription, such as a ChatGPT or a Claude plan.
    subscription,
    /// A key, paid per token.
    key,
    /// An organization that pays for what its members use, whose bill
    /// may be read.
    organization,
  }

  /// One account at the provider, as the part found it.
  record account {
    /// What OTTY keeps the user's name and Hide of the account by: the
    /// same account has the same id in every read, also after its tokens
    /// are renewed. Unique within the plugin.
    id: string,
    /// What the user knows it by, such as `you@example.com` or
    /// `key ••••a1f3`.
    name: string,
    kind: account-kind,
    /// The plan of a subscription, such as "Pro", when the login tells.
    plan: option<string>,
    /// Every folder the account was found in, in the order they were
    /// given. Two logins of one account are one account with two places.
    found-in: list<login-folder>,
    /// What the user must do for the account, such as log in again when
    /// its login expired.
    needs: list<need>,
  }

  /// What the part found in the folders of one call.
  record found {
    accounts: list<account>,
    /// What the user must do that belongs to no account, such as a login
    /// file the part does not understand. A folder with no login gives no
    /// need: that need is the agent part's.
    needs: list<need>,
  }

  /// One usage window, such as the five-hour or the weekly one.
  record limit-window {
    /// How long the window is, when the source tells.
    length-minutes: option<u32>,
    /// The model the window counts alone, such as "Opus"; none for a
    /// window of every model.
    model: option<string>,
    /// How much of the window is used, from 0 to 100; past 100 when
    /// used past its limit.
    percent-used: f64,
    /// When the window starts again, when known.
    resets-at-ms: option<s64>,
    /// When it starts again as the agent wrote it, for a source that
    /// gives no time.
    reset-text: option<string>,
  }

  /// The credits of an account paid for by a pool of credits.
  record credits {
    left: option<f64>,
    used: option<f64>,
    pool: option<f64>,
    renews-at-ms: option<s64>,
    is-unlimited: bool,
  }

  /// An amount in whole units of its currency, such as 12.5 US dollars.
  record money {
    amount: f64,
    /// The ISO code of the currency, such as `USD`.
    currency: string,
  }

  /// How much a key used of its own limit.
  record key-limit {
    used: money,
    /// None for a key with no limit.
    limit: option<money>,
  }

  /// The extra usage a subscription may buy past its windows, while it
  /// is turned on: what was spent on it this month and its monthly limit,
  /// in whole units of the currency.
  record extra-usage {
    used: option<f64>,
    monthly-limit: option<f64>,
    /// The ISO code of the currency, such as `USD`, when it is told.
    currency: option<string>,
  }

  /// The numbers of an account right now; each part is optional. A
  /// subscription has windows, credits and extra usage; a key has the
  /// money left, its own limit, the money spent this month and credits.
  record account-numbers {
    windows: list<limit-window>,
    credits: option<credits>,
    extra-usage: option<extra-usage>,
    left: option<money>,
    key-limit: option<key-limit>,
    spent-this-month: option<money>,
    plan: option<string>,
    /// When the numbers were true, for numbers read from an older record
    /// such as a session file; none when they are true now.
    recorded-at-ms: option<s64>,
  }

  /// The days of a bill, both included, as `YYYY-MM-DD`.
  record day-range {
    first: string,
    last: string,
  }

  /// What one day cost.
  record day-cost {
    day: string,
    cost: money,
  }

  /// The bill of an organization, day by day.
  record bill {
    days: list<day-cost>,
  }

  /// The accounts whose logins sit in `folders`, read with the part's
  /// own permissions there. A part whose manifest names no `logins` gets
  /// no folder and finds none.
  accounts: func(provider: string, folders: list<login-folder>) -> found;
  /// The numbers of `account` right now, read any way the part can, only
  /// in the folders of its `found-in`: from the provider's server with
  /// the login there, or by asking the agent in one of them. `given`
  /// holds the keys the user gave for the account after a need of the
  /// part asked for them, each under its slot. With no way that works
  /// the part answers numbers with nothing in them, not an error; a
  /// refused or expired login is `needs-user` with the need that fixes
  /// it.
  numbers: func(provider: string, account: account, given: list<given-key>) -> result<account-numbers, read-error>;
  /// The bill of the organization `account` over `days`, day by day. A
  /// part that needs a key it has not got answers `needs-user` with
  /// `ask-key`.
  read-bill: func(provider: string, account: account, given: list<given-key>, days: day-range) -> result<bill, read-error>;
  /// The agent's official login command pointed at `folder`, OTTY's own
  /// login folder, such as `codex login` with `CODEX_HOME=<folder>`. OTTY
  /// runs it in a terminal tab the user sees, so OTTY never handles a
  /// password or a login flow itself, and then asks `accounts` about
  /// that folder. None for a part whose manifest offers no `log_in`.
  log-in: func(provider: string, folder: string) -> option<command>;
}

/// What a component with provider parts imports and exports. Files,
/// programs and hidden terminals are there for the ways of reading that
/// ask the agent itself; the part's own permissions apply to them.
world provider-part {
  import otty:host/types@0.1.0;
  import otty:host/keys@0.1.0;
  import otty:host/files@0.1.0;
  import otty:host/http@0.1.0;
  import otty:host/programs@0.1.0;
  import otty:host/terminal@0.1.0;
  import otty:host/env@0.1.0;
  import otty:host/clock@0.1.0;
  import otty:host/log@0.1.0;
  import otty:agents-agent/types@0.1.0;
  export provider;
}
