// The provider contract of the `agents` domain: what a provider part
// gives OTTY. A plugin exports it once for all its provider parts; OTTY
// names the part in each call (the `provider` argument). A provider part
// gets keys only as handles, and only of accounts of its own provider id
// or hosts. It reads an account's numbers any way it can (issue 29): from
// the provider's server with the key, or by asking the agent itself in a
// profile the account was found in, such as `claude /usage` or the
// limits Codex writes in its files. The values it shares with the agent
// contract come from `otty:agents-agent/types`.
package otty:agents-provider@0.1.0;

interface provider {
  use otty:host/types@0.1.0.{command};
  use otty:host/keys@0.1.0.{key, given-key};
  use otty:agents-agent/types@0.1.0.{read-error, identity, login-kind, limit-window, credits};

  /// A profile an account was found in: the agent part that found it and
  /// the profile's config folder, with the command that starts the agent
  /// there. A part that asks the agent itself for numbers runs that
  /// command, with its own arguments, under its own permissions; it knows
  /// the agents it can ask by `plugin` and `agent`.
  record found-profile {
    /// The id of the plugin of the agent part, such as `anthropic`.
    plugin: string,
    /// The id of the agent part, such as `claude-code`.
    agent: string,
    /// The profile's config folder.
    folder: string,
    /// What the agent part's `launch` gives for a new session in the
    /// profile: the program and the variables that point it at the
    /// folder.
    launch: command,
  }

  /// What OTTY found about a login in the agents' files.
  record login-facts {
    kind: login-kind,
    identity: identity,
    plan: option<string>,
    /// Every profile the account was found in, in the order OTTY lists
    /// them; empty for a key the user gave in OTTY.
    found-in: list<found-profile>,
  }

  /// Whose account a key is.
  record account-facts {
    identity: identity,
    plan: option<string>,
  }

  /// An amount in whole units of its currency, such as 12.5 US dollars.
  record money {
    amount: f64,
    /// The ISO code of the currency, such as `USD`.
    currency: string,
  }

  /// How much a key used of its own limit.
  record key-limit {
    used: money,
    /// None for a key with no limit.
    limit: option<money>,
  }

  /// The extra usage a subscription may buy past its windows, while it
  /// is turned on: what was spent on it this month and its monthly limit,
  /// in whole units of the currency.
  record extra-usage {
    used: option<f64>,
    monthly-limit: option<f64>,
    /// The ISO code of the currency, such as `USD`, when it is told.
    currency: option<string>,
  }

  /// The numbers of an account right now; each part is optional. A
  /// subscription has windows, credits and extra usage; a key has the
  /// money left, its own limit, the money spent this month and credits.
  record account-numbers {
    windows: list<limit-window>,
    credits: option<credits>,
    extra-usage: option<extra-usage>,
    left: option<money>,
    key-limit: option<key-limit>,
    spent-this-month: option<money>,
    plan: option<string>,
    /// When the numbers were true, for numbers read from an older record
    /// such as a session file; none when they are true now.
    recorded-at-ms: option<s64>,
  }

  /// The days of a bill, both included, as `YYYY-MM-DD`.
  record day-range {
    first: string,
    last: string,
  }

  /// What one day cost.
  record day-cost {
    day: string,
    cost: money,
  }

  /// The bill of an organization, day by day.
  record bill {
    days: list<day-cost>,
  }

  /// Whose account `key` is.
  account: func(provider: string, key: borrow<key>, found: login-facts) -> result<account-facts, read-error>;
  /// The account's numbers right now, read any way the part can: with the
  /// account's `key` and the keys the user gave for it, or by asking the
  /// agent in a profile of `found`. The key may not be there, such as a
  /// login token Claude Code keeps elsewhere: using the handle then fails
  /// with `not-found`, and the part tries its other ways. With no way
  /// that works the part answers numbers with nothing in them, not an
  /// error.
  numbers: func(provider: string, found: login-facts, account: account-facts, key: borrow<key>, given: list<given-key>) -> result<account-numbers, read-error>;
  /// The bill of an organization, day by day, read with the account's
  /// `key` and the keys the user gave for it. A part that needs a key it
  /// has not got answers `needs-user` with `ask-key`.
  read-bill: func(provider: string, found: login-facts, account: account-facts, key: borrow<key>, given: list<given-key>, days: day-range) -> result<bill, read-error>;
}

/// What a component with provider parts imports and exports. Files,
/// programs and hidden terminals are there for the ways of reading that
/// ask the agent itself; the part's own permissions apply to them.
world provider-part {
  import otty:host/types@0.1.0;
  import otty:host/keys@0.1.0;
  import otty:host/files@0.1.0;
  import otty:host/http@0.1.0;
  import otty:host/programs@0.1.0;
  import otty:host/terminal@0.1.0;
  import otty:host/env@0.1.0;
  import otty:host/clock@0.1.0;
  import otty:host/log@0.1.0;
  import otty:agents-agent/types@0.1.0;
  export provider;
}
