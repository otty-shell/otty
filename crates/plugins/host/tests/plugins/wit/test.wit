// The worlds of the test plugins of `otty-plugin-host`: each one exports
// the stand-in agent contract, and some misbehave on purpose.
package otty:test@0.1.0;

/// Calls that break the engine's limits.
interface misbehave {
  /// Never returns: a loop with no end.
  spin: func() -> u64;
  /// Allocates and touches `mib` MiB, and gives how many bytes it holds.
  hold: func(mib: u32) -> u64;
}

/// A valid plugin with one agent contract.
world minimal {
  export otty:agent/agent@0.1.0;
}

/// A plugin whose `spin` never ends.
world spin {
  export otty:agent/agent@0.1.0;
  export misbehave;
}

/// A plugin whose `hold` grabs as much memory as it is asked for.
world grab-memory {
  export otty:agent/agent@0.1.0;
  export misbehave;
}

/// A plugin that reads a file with the standard library, so it imports
/// `wasi:filesystem`.
world read-files {
  export otty:agent/agent@0.1.0;
}
